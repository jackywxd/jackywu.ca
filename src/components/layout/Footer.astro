---
import { site } from '@/lib/site';
import SnowMark from '@/components/brand/SnowMark.astro';
const year = new Date().getFullYear();
---
<footer class="ftr" data-pagefind-ignore>
  <div class="shell ftr-in">
    <SnowMark variant="seal" size="1.4rem" />
    <p>{site.name} · {site.signature}</p>
    <p class="yr">{year}</p>
  </div>
</footer>

<style>
  .ftr { border-block-start: 1px solid var(--edge); margin-block-start: var(--space-7); }
  .ftr-in {
    display: flex; align-items: center; gap: var(--space-2);
    padding-block: var(--space-4);
    font-size: var(--text-xs); color: var(--fg-3);
  }
  .yr { margin-inline-start: auto; font-variant-numeric: tabular-nums; }
</style>
