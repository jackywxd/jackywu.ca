---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { monthDay, isoDate, mmss, mb } from '@/lib/format';
import { realms } from '@/lib/site';

interface Props { id: string; data: CollectionEntry<'reel'>['data'] }
const { id, data } = Astro.props;
const r = realms[data.realm];
---
<article class="card unfurl" data-realm={data.realm}>
  <a href={`/reel/#${id}`} class="hit">
    <div class="thumb" style={`aspect-ratio:${data.ratio}`}>
      <Picture src={data.poster} alt={data.posterAlt} widths={[240, 480]} sizes="180px"
               formats={['avif', 'webp']} loading="lazy" />
      <span class="play" aria-hidden="true"></span>
    </div>
    <div class="body">
      <h3>{data.title}</h3>
      <p class="meta">
        <span class="tag">{r.label}</span>
        <time datetime={isoDate(data.date)}>{monthDay(data.date)}</time>
        <span>{mmss(data.duration)} · 約 {mb(data.bytes)}</span>
      </p>
      {data.caption && <p class="cap">{data.caption}</p>}
    </div>
  </a>
</article>

<style>
  .card { border-block-end: 1px solid var(--edge); }
  .hit { display: flex; gap: var(--space-3); padding: var(--space-3); align-items: flex-start; }
  .thumb { position: relative; flex: none; inline-size: 180px; overflow: hidden; }
  .thumb :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .play {
    position: absolute; inset: 0; margin: auto;
    inline-size: 0; block-size: 0;
    border-block: 11px solid transparent;
    border-inline-start: 18px solid var(--paper);
    filter: drop-shadow(0 0 6px rgb(0 0 0 / 0.35));
  }
  h3 { font-size: var(--text-lg); }
  .meta {
    margin-block-start: var(--space-1);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
    font-size: var(--text-xs); color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .tag {
    padding-inline: 0.45rem; padding-block: 0.1rem;
    border: 1px solid var(--edge);
    color: var(--fg-3);
  }
  .cap { margin-block-start: var(--space-1); font-size: var(--text-sm); color: var(--fg-2); }
</style>
