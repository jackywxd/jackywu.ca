---
import { ganzhi } from '@/lib/format';
interface Props { year: number; link?: boolean }
const { year, link = true } = Astro.props;
---
<div class="year">
  <span class="year-bloom" aria-hidden="true"></span>
  <h2 class="year-mark">
    {link ? (
      <a href={`/tales/${year}/`}>
        <span class="num">{year}</span>
        <span class="gz" aria-hidden="true">{ganzhi(year)}</span>
      </a>
    ) : (
      <>
        <span class="num">{year}</span>
        <span class="gz" aria-hidden="true">{ganzhi(year)}</span>
      </>
    )}
  </h2>
</div>

<style>
  .year { position: relative; padding-block: var(--space-5) var(--space-3); }
  .year-bloom {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: -2.5rem;
    inline-size: 14rem; block-size: 14rem;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--fg) 9%, transparent) 0%, transparent 68%);
    pointer-events: none;
  }
  .year-mark { display: flex; align-items: baseline; gap: 0.7rem; position: relative; }
  .year-mark a {
    display: flex; align-items: baseline; gap: 0.7rem;
    transition: color var(--dur-ink) var(--ease-brush);
  }
  .year-mark a:hover { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .year-mark a { transition: none; } }
  .num {
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  .gz { font-size: var(--text-sm); color: var(--fg-3); letter-spacing: 0.3em; }
</style>
