---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * 圖 + 圖說。
 *
 * 圖片永不滿版 —— 最寬 measure + 8rem。滿版是雜誌感，不是宣紙。
 * wide 讓它稍微溢出正文欄，用在真正需要的橫幅照片。
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** 溢出正文欄一些。預設不溢出 */
  wide?: boolean;
  /** 首屏的圖傳 true，會用 eager + high priority */
  priority?: boolean;
  /** 整張圖是連結（例如 YouTube 縮圖） */
  href?: string;
}
const { src, alt, caption, wide = false, priority = false, href } = Astro.props;
const pic = {
  src, alt,
  widths: [420, 840, 1260, 1680],
  sizes: wide ? '(min-width: 64rem) 42rem, 92vw' : '(min-width: 64rem) 34rem, 92vw',
  formats: ['avif', 'webp'] as ('avif' | 'webp')[],
  loading: (priority ? 'eager' : 'lazy') as 'eager' | 'lazy',
  fetchpriority: (priority ? 'high' : 'auto') as 'high' | 'auto',
  decoding: 'async' as const,
};
---
<figure class:list={['fig', wide && 'is-wide']}>
  {href
    ? <a href={href} rel="noopener noreferrer"><Picture {...pic} /></a>
    : <Picture {...pic} />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

