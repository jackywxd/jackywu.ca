---
/**
 * 三個 variant，同一份路徑：
 *  solid     — 導覽 / favicon，單色 currentColor
 *  full      — 雙層（殘影 + 實層），落款與匾額用
 *  watermark — 巨大浮水印，永遠切出版面邊緣（完整置中是企業感，
 *              被裁切的才是宣紙上蓋歪的印）
 */
interface Props {
  variant?: 'solid' | 'full' | 'watermark' | 'seal' | 'ring';
  size?: string;
  class?: string;
  title?: string;
}
const { variant = 'solid', size = '1.75rem', class: cls = '', title } = Astro.props;
const href =
  variant === 'solid' ? '#snow-solid' :
  variant === 'seal'  ? '#snow-chop' :
  variant === 'ring'  ? '#snow-ring'  : '#snow-full';
---
<svg
  class:list={['snow-mark', `is-${variant}`, cls]}
  style={variant === 'watermark' ? undefined : `width:${size};height:${size}`}
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
><use href={href} /></svg>

<style>
  .snow-mark { fill: currentColor; flex: none; }

  /* 雙層：殘影淡、實層實 */
  .snow-mark.is-full :global(.snow-trail),
  .snow-mark.is-watermark :global(.snow-trail) { fill: var(--fg-3); opacity: 0.55; }
  .snow-mark.is-full :global(.snow-solid),
  .snow-mark.is-watermark :global(.snow-solid) { fill: currentColor; }

  /* 圓印：整枚朱砂。殘影層淡一階，保留兩層錯位的層次 */
  .snow-mark.is-seal { color: var(--seal); }
  .snow-mark.is-ring { color: var(--seal); }
  .snow-mark.is-ring :global(.snow-trail) { fill: currentColor; opacity: 0.45; }
  .snow-mark.is-ring :global(.snow-solid) { fill: currentColor; opacity: 1; }

  .snow-mark.is-watermark {
    position: absolute;
    inset-block-start: -8%;
    inset-inline-end: -18%;      /* 切出右緣 */
    width: clamp(20rem, 45vw, 42rem);
    height: auto;
    aspect-ratio: 1;
    opacity: 0.06;
    pointer-events: none;
    z-index: 0;
  }
  .snow-mark.is-watermark :global(.snow-trail) { opacity: 0.8; }

  /* 窄螢幕：縮小並往外推，別壓在標題上 */
  @media (max-width: 46rem) {
    /* 圓印：整枚朱砂。殘影層淡一階，保留兩層錯位的層次 */
  .snow-mark.is-seal { color: var(--seal); }
  .snow-mark.is-ring { color: var(--seal); }
  .snow-mark.is-ring :global(.snow-trail) { fill: currentColor; opacity: 0.45; }
  .snow-mark.is-ring :global(.snow-solid) { fill: currentColor; opacity: 1; }

  .snow-mark.is-watermark {
      width: clamp(14rem, 62vw, 22rem);
      inset-inline-end: -30%;
      inset-block-start: -4%;
      opacity: 0.045;
    }
  }
</style>
