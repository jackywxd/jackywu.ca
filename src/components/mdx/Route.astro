---
/**
 * 文章裡的路線圖。
 *
 * 預設畫的是**爬升剖面**而不是平面輪廓 —— 一條俯視的曲線只說明「繞了一圈」，
 * 而讀者想知道的是「那裡有多陡、我在第幾公里垮掉的」。平面圖要用 show="track"。
 *
 * 剖面的 x 軸是累計距離的線性映射（見 scripts/lib/gpx.mjs 的 profileSvg：
 * x = cum[j] / total * 1000），所以「第 40 公里在哪」算得出來。這是
 * from/to 與 at 能成立的原因，也是這個元件跟一張裝飾用的圖的差別：
 *
 *   <Route of="whistler-utmb-100k-2026" from={40} to={55} />
 *
 * 旁邊那段文字在講哪一段，圖就亮哪一段。
 *
 * 標記與刻度用 HTML 疊在 SVG 上，不畫進 SVG 裡 —— 剖面用
 * preserveAspectRatio="none"，SVG 內的文字與線寬都會被水平拉扯變形。
 */
import { getCollection } from 'astro:content';
import { km as fmtKm, vert } from '@/lib/format';

interface Props {
  /** 路線 slug，可寫 `whistler-utmb-100k-2026` 或含年份的 `2026/whistler-utmb-100k-2026` */
  of: string;
  show?: 'profile' | 'track' | 'both';
  /** 高亮這一段（公里） */
  from?: number;
  to?: number;
  /** 在某一公里處標一筆 */
  at?: number;
  label?: string;
  caption?: string;
}
const { of, show = 'profile', from, to, at, label, caption } = Astro.props;

const routes = await getCollection('routes');
const entry = routes.find((r) => r.id === of || r.id.endsWith(`/${of}`));
if (!entry) {
  throw new Error(
    `<Route of="${of}"> 找不到這條路線。現有的是：\n  ${routes.map((r) => r.id).join('\n  ')}`,
  );
}
const d = entry.data;

const raw = import.meta.glob<string>('/src/content/routes/**/*.svg', {
  query: '?raw', import: 'default', eager: true,
});
/** 取內容，去掉外層 <svg> 與會在同一頁重複的 id */
const inner = (suffix: string) => {
  const hit = raw[`/src/content/routes/${entry.id}${suffix}`];
  return hit
    ? hit.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/\sid="[^"]*"/g, '')
    : null;
};
const profile = inner('.profile.svg');
const track = inner('.svg');

const wantProfile = show !== 'track' && profile;
const wantTrack = show !== 'profile' && track;

/** 公里 → 0–100 的百分比。夾住兩端，免得寫錯的 km 把圖推出版面 */
const pct = (n: number) => Math.round(Math.min(100, Math.max(0, (n / d.distanceKm) * 100)) * 100) / 100;

const seg = from != null || to != null
  ? { a: pct(from ?? 0), b: pct(to ?? d.distanceKm) }
  : null;

/** 刻度取整齊的間隔，目標 4–7 條 */
function ticks(totalKm: number) {
  const step = [1, 2, 5, 10, 20, 25, 50, 100].find((s) => totalKm / s <= 7) ?? 100;
  const out: number[] = [];
  for (let k = step; k < totalKm; k += step) out.push(k);
  return out;
}

const summary = [
  d.name,
  fmtKm(d.distanceKm),
  d.gainM != null ? `累計爬升 ${vert(d.gainM)}` : null,
  seg ? `高亮 ${Math.round(from ?? 0)}–${Math.round(to ?? d.distanceKm)} 公里` : null,
].filter(Boolean).join('，');
---

<figure class="route" data-realm={d.realm}>
  <div class="stats">
    <span class="name">{d.name}</span>
    <span class="dot" aria-hidden="true">·</span>
    <span class="num">{fmtKm(d.distanceKm)}</span>
    {d.gainM != null && <><span class="dot" aria-hidden="true">·</span><span class="num">{vert(d.gainM)}</span></>}
    {d.elapsed && <><span class="dot" aria-hidden="true">·</span><span class="num">{d.elapsed}</span></>}
  </div>

  {wantProfile && (
    <div class="prof" role="img" aria-label={`爬升剖面：${summary}`}>
      <svg class="layer base" viewBox="0 0 1000 220" preserveAspectRatio="none" set:html={profile} />
      {seg && (
        <div class="lit-wrap" style={`clip-path: inset(0 ${100 - seg.b}% 0 ${seg.a}%)`}>
          <svg class="layer lit" viewBox="0 0 1000 220" preserveAspectRatio="none" set:html={profile} />
        </div>
      )}
      {ticks(d.distanceKm).map((k) => (
        <span class="tick" style={`left:${pct(k)}%`}><i aria-hidden="true"></i><b>{k}</b></span>
      ))}
      {/* data-side：靠邊的標記不能置中對齊，否則標籤會溢出圖外 */}
      {at != null && (
        <span class="mark" data-side={pct(at) < 8 ? 'start' : pct(at) > 92 ? 'end' : null}
              style={`left:${pct(at)}%`}>
          <i aria-hidden="true"></i>
          <b>{label ?? `${at} 公里`}</b>
        </span>
      )}
    </div>
  )}

  {wantTrack && (
    <svg class="track" viewBox="0 0 1000 1000" fill="none" role="img"
         aria-label={`路線輪廓：${d.name}`} set:html={track} />
  )}

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .route {
    margin-block: var(--space-4);
    /* 圖比正文寬一點，但永不滿版 —— 滿版是雜誌感，不是宣紙 */
    margin-inline: calc(-1 * var(--space-3));
    padding-inline: var(--space-3);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45em;
    font-size: var(--text-xs);
    color: var(--fg-3);
    margin-block-end: 0.6rem;
  }
  .name { font-family: var(--font-display); color: var(--fg-2); letter-spacing: 0.06em; }
  .num { font-variant-numeric: tabular-nums; }
  .dot { color: var(--fg-mute); }

  /* ── 剖面 ── */
  .prof {
    position: relative;
    block-size: 132px;
    border-block-end: 1px solid var(--edge);
  }
  .layer {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }
  .base { color: color-mix(in oklab, var(--fg) 20%, transparent); }
  .lit-wrap { position: absolute; inset: 0; }
  .lit { color: var(--accent, var(--seal)); }

  /* 刻度與標記疊在外面：剖面是 preserveAspectRatio="none"，
     畫進 SVG 裡的字會被拉扁 */
  .tick, .mark {
    position: absolute;
    inset-block: 0;
    inline-size: 0;
  }
  .tick i, .mark i {
    position: absolute;
    inset-block: 0;
    inline-size: 1px;
  }
  .tick i { background: color-mix(in oklab, var(--fg) 10%, transparent); }
  .mark i { background: var(--seal); }

  .tick b, .mark b {
    position: absolute;
    inset-block-end: -1.55em;
    font-weight: 400;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transform: translateX(-50%);
  }
  .tick b { color: var(--fg-mute); }
  .mark[data-side='start'] b { transform: none; }
  .mark[data-side='end'] b { transform: translateX(-100%); }
  .mark b {
    inset-block-end: auto;
    inset-block-start: -0.2em;
    color: var(--seal);
    font-family: var(--font-display);
    letter-spacing: 0.06em;
  }

  /* 刻度標籤在下方，要留出空間 */
  .prof { margin-block-end: 1.9em; }

  /* ── 平面輪廓 ── */
  .track {
    display: block;
    inline-size: 100%;
    max-inline-size: 22rem;
    margin-inline: auto;
    margin-block-start: var(--space-3);
    color: color-mix(in oklab, var(--fg) 55%, transparent);
    stroke: currentColor;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  figcaption {
    margin-block-start: 0.7rem;
    font-size: var(--text-xs);
    color: var(--fg-3);
    text-align: center;
  }
</style>
