---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from './Base.astro';
import Seal from '@/components/brand/Seal.astro';
import { site, realms } from '@/lib/site';
import { monthDay, isoDate } from '@/lib/format';
import { shareUrls } from '@/lib/poster/paths';
import { fromTale } from '@/lib/poster/item';
import { sharePayload, absolute } from '@/lib/share';
import ShareSheet from '@/components/share/ShareSheet.astro';

interface Props { entry: CollectionEntry<'tales'> }
const { entry } = Astro.props;
const d = entry.data;
const r = realms[d.realm];
const quiet = d.realm === 'still' || !d.shareable;
const url = absolute(`/tales/${entry.id}/`);
const urls = shareUrls('tales', entry.id);
const item = fromTale(entry.id, d);
const payload = sharePayload({ title: d.title, hook: d.verse ?? d.excerpt, tags: item.tags, url });

// realm: still 走「靜」：不輸出 og:image、不輸出微信首圖、不出現分享面板，
// JSON-LD 只留最小 Article。
const jsonLd = quiet
  ? { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, inLanguage: d.lang, url }
  : {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: d.title,
      description: d.excerpt,
      datePublished: isoDate(d.date),
      dateModified: isoDate(d.updated ?? d.date),
      inLanguage: d.lang,
      keywords: d.tags.join(', '),
      image: absolute(urls.og),
      author: { '@type': 'Person', name: site.author, alternateName: site.signature },
      publisher: { '@type': 'Organization', name: site.name },
      mainEntityOfPage: url,
    };
---
<Base
  title={d.title}
  description={d.excerpt}
  realm={quiet ? undefined : d.realm}
  share={quiet ? undefined : { og: urls.og, wx: urls.wx }}
  jsonLd={jsonLd}
  ogType="article"
>
  <article class="tale" lang={d.lang}>
    <div class="shell">
      <header class="head">
        <p class="kicker">
          {!quiet && <span class="realm">{r.label}</span>}
          <time datetime={isoDate(d.date)}>{d.date.getUTCFullYear()} · {monthDay(d.date)}</time>
          {d.draft && <span class="draft">草稿</span>}
        </p>
        <h1>{d.title}</h1>
        {d.verse && <p class="verse">{d.verse}</p>}
      </header>

      {d.hero && (
        <figure class="hero">
          <Picture src={d.hero} alt={d.heroAlt ?? ''} widths={[640, 960, 1280]}
                   sizes="(min-width: 64rem) 42rem, 92vw" formats={['avif', 'webp']} loading="eager" />
        </figure>
      )}

      <div class="scroll"><slot /></div>

      {d.tags.length > 0 && (
        <ul class="tags">
          {d.tags.map((t) => <li><a href={`/tags/${encodeURIComponent(t)}/`}>{t}</a></li>)}
        </ul>
      )}
      {!quiet && <ShareSheet poster={urls.poster} payload={payload} title={d.title} />}
      <Seal />
      <p class="vertical-run sig" aria-hidden="true">{site.signature}</p>
    </div>
  </article>
</Base>

<style>
  .tale { padding-block: var(--space-5) var(--space-6); }
  .tale .shell { position: relative; }
  .head { max-inline-size: var(--measure); margin-block-end: var(--space-4); }
  .kicker {
    display: flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-xs); color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .realm { color: var(--accent); }
  .draft { border: 1px solid var(--edge); padding-inline: 0.4rem; }
  h1 { margin-block-start: var(--space-2); font-size: var(--text-3xl); }
  .verse {
    margin-block-start: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-verse);
    color: var(--fg-2);
  }
  .hero { margin-block: var(--space-4); max-inline-size: calc(var(--measure) + 8rem); }
  .tags {
    display: flex; flex-wrap: wrap; gap: var(--space-2);
    list-style: none; padding: 0;
    margin-block-start: var(--space-4);
    max-inline-size: var(--measure);
    font-size: var(--text-xs);
  }
  .tags a { color: var(--fg-3); border-block-end: 1px solid var(--edge); }
  .tags a:hover { color: var(--fg); }
  /* 直排元素必須用物理屬性定位：writing-mode: vertical-rl 會讓
     inset-block-start 解析成「距右緣」、inset-inline-end 解析成「貼底」，
     因為邏輯屬性是相對元素自己的書寫方向。 */
  .sig { position: absolute; top: 7rem; right: 0; }
  @media (max-width: 64rem) { .sig { display: none; } }
</style>
