---
import '@/styles/global.css';
import { site } from '@/lib/site';
import { absolute } from '@/lib/share';
import SnowSprite from '@/components/brand/SnowSprite.astro';
import WeChatThumb from '@/components/share/WeChatThumb.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  realm?: string;
  /** 有分享圖的頁面傳這個：og / wx 兩張建置期產物的路徑 */
  share?: { og: string; wx: string };
  jsonLd?: Record<string, unknown>;
  ogType?: 'website' | 'article';
}
const { title, description = site.description, realm, share, jsonLd, ogType = 'website' } = Astro.props;

// 微信站內分享唯一能控制的兩個東西就是 <title> 與 description
const fullTitle = title ? `${title}｜${site.name}` : `${site.name} · ${site.signature}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = absolute(share?.og ?? '/og-default.png');
---
<!doctype html>
<html lang="zh-Hant" data-realm={realm}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {share && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${title ?? site.name} — ${site.name}`} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}

    {/* 防閃白：在第一次繪製前就把 data-theme 定下來 */}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
      // 開場落款一次瀏覽只演一次。在第一次繪製前決定，避免閃一下才消失。
      try {
        if (!sessionStorage.getItem('inn:seen')) {
          document.documentElement.dataset.intro = '';
          sessionStorage.setItem('inn:seen', '1');
        }
      } catch {}
    </script>
  </head>
  <body>
    {/* 必須是 <body> 裡第一張圖 —— 微信就抓這張 */}
    {share && <WeChatThumb src={share.wx} />}
    <SnowSprite />
    <a class="skip" href="#main">跳至內容</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: -9999px;
    inset-block-start: 0;
    z-index: 50;
    padding: var(--space-2) var(--space-3);
    background: var(--panel);
    border: 1px solid var(--edge);
  }
  .skip:focus { inset-inline-start: var(--gutter); inset-block-start: var(--space-2); }
</style>
