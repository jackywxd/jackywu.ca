---
import Base from '@/layouts/Base.astro';
import SnowMark from '@/components/brand/SnowMark.astro';
import InkRule from '@/components/ink/InkRule.astro';
import { site } from '@/lib/site';
---
<Base title="掌櫃" description={`${site.author} · ${site.signature}`}>
  <section class="keeper">
    <SnowMark variant="watermark" />
    <div class="shell inner">
      <h1>掌櫃</h1>
      <div class="scroll">
        <p>
          店主 <strong>{site.author}</strong>，江湖上署名<strong>{site.signature}</strong>。
          長跑、滑雪、鐵馬、探幽，走過的路都記在門前那條時間軸上。
        </p>
        <InkRule />
        <p class="todo">
          這一頁還沒寫完 —— 生平、器械、聯絡方式待補。
        </p>
      </div>
      <div class="mark"><SnowMark variant="full" size="4rem" /></div>
    </div>
  </section>
</Base>

<style>
  .keeper { position: relative; overflow: clip; }
  .inner { position: relative; z-index: 1; padding-block: var(--space-6); }
  h1 { font-size: clamp(2.6rem, 8vw, 5rem); letter-spacing: 0.08em; margin-block-end: var(--space-4); }
  .todo { color: var(--fg-3); font-size: var(--text-sm); }
  .mark { margin-block-start: var(--space-5); color: var(--seal); }
</style>
