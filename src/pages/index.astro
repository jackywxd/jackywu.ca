---
import Base from '@/layouts/Base.astro';
import SnowMark from '@/components/brand/SnowMark.astro';
import { site } from '@/lib/site';
---
<Base>
  <section class="gate">
    <SnowMark variant="watermark" />
    <div class="shell gate-in">
      <div class="placard measure">
        <h1>{site.name}</h1>
        <p class="verse">江湖夜雨十年燈，一盞留與行路人。</p>
        <p class="lede">{site.description}</p>
      </div>
      <p class="vertical-run sig" aria-hidden="true">{site.signature}</p>
    </div>
  </section>
</Base>

<style>
  .gate { position: relative; overflow: clip; }
  .gate-in {
    position: relative; z-index: 1;
    display: flex; justify-content: space-between; gap: var(--space-4);
    padding-block: var(--space-7) var(--space-6);
    min-block-size: 62vh;
  }
  h1 {
    font-size: clamp(3rem, 11vw, 7.5rem);
    letter-spacing: 0.06em;
    line-height: 1.05;
  }
  .verse {
    margin-block-start: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-verse);
    color: var(--fg-2);
  }
  .lede {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    color: var(--fg-3);
  }
  .sig { align-self: flex-start; margin-block-start: var(--space-2); }
  @media (max-width: 64rem) { .sig { display: none; } }  /* 手機沒有那條留白，硬塞就破功 */
</style>
