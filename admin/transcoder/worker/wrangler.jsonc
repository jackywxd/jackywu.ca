{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hongchen-transcoder",
  "main": "index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  // 沒有 routes、沒有 workers.dev：只有後台的 service binding 叫得到
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    { "class_name": "Transcoder", "image": "../container/Dockerfile", "max_instances": 2, "instance_type": "standard-2" }
  ],
  "durable_objects": { "bindings": [{ "class_name": "Transcoder", "name": "TRANSCODER" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Transcoder"] }],
  "env": {
    "staging": {
      "name": "hongchen-transcoder-staging",
      "workers_dev": false,
      "preview_urls": false,
      "containers": [{ "class_name": "Transcoder", "image": "../container/Dockerfile", "max_instances": 1, "instance_type": "standard-2" }],
      "durable_objects": { "bindings": [{ "class_name": "Transcoder", "name": "TRANSCODER" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Transcoder"] }]
    }
  }
}
