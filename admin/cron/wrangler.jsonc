{
  "name": "hongchen-admin-cron",
  "main": "index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "services": [{ "binding": "ADMIN", "service": "hongchen-admin" }],
  "env": {
    "staging": {
      "name": "hongchen-admin-cron-staging",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": { "crons": ["*/5 * * * *"] },
      "services": [{ "binding": "ADMIN", "service": "hongchen-admin-staging" }]
    }
  }
}
