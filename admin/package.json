{
  "name": "hongchen-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "test": "vitest run",
    "verify:deps": "node scripts/verify-deps.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "test:e2e": "pnpm build:worker && playwright test",
    "test:e2e:run": "playwright test",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "migrate:push": "tsx scripts/migrate-push.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@lexical/code": "0.50.0",
    "@lexical/link": "0.50.0",
    "@lexical/list": "0.50.0",
    "@lexical/markdown": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lexical/selection": "0.50.0",
    "@lexical/table": "0.50.0",
    "@lexical/utils": "0.50.0",
    "@opennextjs/cloudflare": "1.20.12",
    "@payloadcms/db-d1-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-r2": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@tailwindcss/postcss": "4.3.3",
    "fflate": "0.8.3",
    "graphql": "16.14.2",
    "jose": "6.2.12",
    "lexical": "0.50.0",
    "next": "16.4.2",
    "payload": "3.91.0",
    "postcss": "8.5.30",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.3.3",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@fontsource/lxgw-wenkai-tc": "5.3.0",
    "@lexical/headless": "0.50.0",
    "@playwright/test": "1.64.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  }
}
